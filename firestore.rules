rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin panel accounts (admin_panel_vehiclehub). Admin status is a custom
    // claim ({ admin: true }) set with the Admin SDK — see
    // admin_panel_vehiclehub/scripts/admin-auth.mjs — so no admin address
    // has to ship in the panel's public code. The email must be verified too.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.get('admin', false) == true;
    }

    // The signed-in owner of users/{email}. The address must be verified,
    // otherwise anyone could sign up with an address that isn't theirs yet
    // and be handed that address's data.
    function isOwner(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
    }

    // User data is keyed by the account's email address.
    match /users/{email}/{document=**} {
      allow read, write: if isOwner(email);
      // Admin panel: view, edit and delete any user's data.
      allow read, write: if isAdmin();
    }

    // Admin panel totals across all users (collection-group counts).
    match /{path=**}/vehicles/{id} { allow read: if isAdmin(); }
    match /{path=**}/services/{id} { allow read: if isAdmin(); }
    match /{path=**}/fuelLogs/{id} { allow read: if isAdmin(); }
    match /{path=**}/documents/{id} { allow read: if isAdmin(); }
    match /{path=**}/schedules/{id} { allow read: if isAdmin(); }

    // Shared service catalogue: readable by any signed-in user, edited from the console only.
    match /service/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Currency list for the currency pickers (currencies/{ISO code}).
    // Readable before sign-in: the first-run setup asks for a currency before
    // the user has an account. Edited from the admin panel.
    match /currencies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Vehicle brand list for the Add/Edit vehicle autocomplete; admin-edited.
    match /brands/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Per-brand model lists (models/{brand lower-cased}); admin-edited.
    match /models/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Suggestion lists for service detail fields (serviceOptions/{list},
    // e.g. tireBrands, tireSizes); admin-edited.
    match /serviceOptions/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // The three logs below hold values users typed that weren't in a list,
    // for review in the admin panel. The app may only create entries, with
    // exactly the fields it writes; only admins can read, edit or remove them.

    // Brands. The doc id is the lower-cased brand, so each brand can exist only once.
    match /log/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type', 'brand', 'platform', 'createdAt'])
        && request.resource.data.type == 'custom_brand'
        && request.resource.data.brand is string
        && request.resource.data.brand.size() > 0
        && request.resource.data.brand.size() <= 60
        && docId == request.resource.data.brand.lower().replace('/', '-');
      allow read, update, delete: if isAdmin();
    }

    // Service detail values. Auto ids, so the same value can be logged more than once.
    match /serviceOptionLog/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['list', 'value', 'service', 'field', 'parent', 'platform', 'createdAt'])
        && request.resource.data.list is string
        && request.resource.data.list.size() > 0
        && request.resource.data.list.size() <= 100
        && request.resource.data.value is string
        && request.resource.data.value.size() > 0
        && request.resource.data.value.size() <= 60;
      allow read, update, delete: if isAdmin();
    }

    // Models. Auto ids, so the same model can be logged more than once.
    match /modelLog/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['brand', 'model', 'platform', 'createdAt'])
        && request.resource.data.brand is string
        && request.resource.data.brand.size() > 0
        && request.resource.data.brand.size() <= 60
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 60;
      allow read, update, delete: if isAdmin();
    }
  }
}
